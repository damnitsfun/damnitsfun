{
  "name": "contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Foundry project: DamnitsEscrow.sol (entry fee, commit-reveal, settlement). Built with forge, not yarn.",
  "scripts": {
    "setup": "forge install --no-git OpenZeppelin/openzeppelin-contracts@v5.6.1 && forge install --no-git foundry-rs/forge-std",
    "build": "forge build",
    "test": "forge test",
    "lint": "forge fmt --check",
    "fmt": "forge fmt",
    "gas": "forge test --gas-report",
    "deploy:testnet": "forge script script/Deploy.s.sol:Deploy --rpc-url \"$BSC_TESTNET_RPC_URL\" --broadcast"
  }
}
