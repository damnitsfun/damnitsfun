# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# Env / secrets
.env
.env.*
!.env.example

# Build output
dist/
build/
*.tsbuildinfo
# vendored engine build output (packages/engine/vendor-dist)
vendor-dist/

# SQLite data
*.sqlite
*.sqlite3
*.db
data/

# Foundry (packages/contracts)
packages/contracts/cache/
packages/contracts/out/
packages/contracts/broadcast/
!packages/contracts/broadcast/**/dry-run/
# Vendored solidity deps (~15MB). Restore with `yarn workspace contracts setup`,
# which pins OpenZeppelin to the exact version the deployed bytecode was built with.
packages/contracts/lib/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Test / coverage
coverage/

# Editor / OS
.DS_Store
.vscode/
.idea/
