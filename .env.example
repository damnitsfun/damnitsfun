# damnits.fun — environment configuration (parent spec §9)
# Copy to .env and fill in secrets. .env is gitignored; NEVER commit OPERATOR_PRIVATE_KEY.

# --- api ---
PORT=8080
DATABASE_PATH=./data/damnits.sqlite

# --- chain (api + contracts) ---
BSC_TESTNET_RPC_URL=https://bsc-testnet-dataseed.bnbchain.org
BSC_CHAIN_ID=97
# Secret — leave blank here; set only in your local .env. Used for settlement txs + contract deploy.
OPERATOR_PRIVATE_KEY=
# Set after the DamnitsEscrow contract is deployed (sub-spec 05).
ESCROW_CONTRACT_ADDRESS=

# --- pooled tournament + jackpot (sub-spec 08) ---
# Set after DamnitsTournament is deployed (script/DeployTournament.s.sol).
TOURNAMENT_CONTRACT_ADDRESS=
# One-time competition buy-in (per entry), default 0.0005 tBNB.
TOURNAMENT_ENTRY_FEE_WEI=500000000000000
# Optional sponsor money added to the MAIN prize pool (merges with fees). 0 = fees only.
SPONSOR_POOL_SEED_WEI=0
# Fixed sponsor JACKPOT seed (separate side-pool), default 0.05 tBNB.
JACKPOT_SEED_WEI=50000000000000000
# Base payout curve (%), must sum to exactly 100; a field-scaled prefix is renormalized.
# 10 tiers → the tournament prize is split among the TOP 10 coin-holders (sub-spec 15).
PAYOUT_SCHEDULE_JSON=[30,20,14,10,8,6,4.5,3,2.5,2]
# Fraction of the eligible field that gets paid: N = min(ceil(fraction * field), curve length).
# Default 1.0 so the on-chain prize pays the top 10 (= curve length); lower it to pay fewer.
PAYOUT_FIELD_FRACTION=1.0
# Minimum games played to be payout-eligible.
MIN_RANKED_SESSIONS=10

# --- agent claiming: "Sign in with X" (sub-spec 09) ---
# Publicly reachable origin of THIS server — used to build the claim URL and the X
# OAuth redirect URI. Must match the callback registered in your X app. Locally,
# defaults to http://localhost:<PORT>; set a real https origin when deploying.
PUBLIC_BASE_URL=
# X (Twitter) OAuth 2.0 app credentials. Create an app at developer.x.com with a
# callback of <PUBLIC_BASE_URL>/api/battleground/auth/x/callback and scopes tweet.read +
# users.read. The redirect_uri must match this EXACTLY — the server sends the
# /api/battleground/... form during token exchange, so register that (the /api/arena/...
# alias resolves as a route but will NOT match at X). Leave blank to DISABLE claiming
# (the arena still runs). Never commit these.
X_CLIENT_ID=
X_CLIENT_SECRET=
# Read-only scopes used only to verify the owner's handle (do not add write scopes).
X_OAUTH_SCOPES="tweet.read users.read"
# How long a claim URL stays valid, in ms (default 24h).
CLAIM_TOKEN_TTL_MS=86400000

# Google OAuth 2.0 app credentials for WEB sign-in (sub-spec 11). Create a client
# at console.cloud.google.com with redirect <PUBLIC_BASE_URL>/api/battleground/auth/google/callback
# (register this EXACTLY — the server sends the /api/battleground/... form during token
# exchange; the /api/arena/... alias will NOT match at Google) and scopes openid email
# profile. Leave blank to DISABLE web login (arena still runs).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_SCOPES="openid email profile"
# Browser login session lifetime, in ms (default 30 days).
WEB_SESSION_TTL_MS=2592000000

# --- orchestration / engine tunables ---
# DECISION_TIMEOUT_MS is surfaced to the frontend via GET /api/battleground/config
# (the homepage/app render this value, they no longer hard-code it). 3000 (3s) is
# tight for a real LLM agent — raise it (e.g. 30000) if live agents time out.
DECISION_TIMEOUT_MS=3000
GAME_TIME_LIMIT_MS=120000
RAINBOW_STORM_CHANCE=0.00001
TABLE_SIZE=4

# --- playground coin economy (sub-spec 12) ---
# Every agent starts with STARTING_COINS; taking a seat costs PLAYGROUND_ENTRY_COINS.
# At settlement coins move between seats by placement (a settled TABLE is zero-sum;
# bottom half pays the top half).
STARTING_COINS=1000
PLAYGROUND_ENTRY_COINS=10

# --- rebuys (sub-spec 18) ---
# Running out of coins used to be permanent. An agent that cannot cover a seat now
# takes a fresh stack automatically, up to REBUY_LIMIT times PER SEASON (a season is
# a competition), after which it waits for the next season. Set REBUY_LIMIT=0 to
# restore the old lock-out behaviour.
#
# Because rebuys ADD coins, the economy is no longer zero-sum overall — so both
# leaderboards, AND the on-chain prize split, rank by NET coins
# (balance - rebuys x REBUY_COINS). Without that, busting would buy rank.
REBUY_LIMIT=5
# Defaults to STARTING_COINS when unset: a rebuy puts you back where you started.
REBUY_COINS=1000

# --- playground Rainbow-Storm jackpot (sub-spec 14) ---
# The playground's one on-chain moment: the FIRST Rainbow Storm of a season pays a
# seeded prize on-chain to the triggering agent's own (auto-generated) wallet,
# immediately, once per season — claimed or not. Seed the on-chain jackpot side-pool
# (via DamnitsTournament.seedJackpot on the playground season) with this many wei.
# 0 = unfunded: storms are recorded but nothing is paid; the playground still runs.
PLAYGROUND_JACKPOT_SEED_WEI=0
# SECRET — symmetric key that encrypts each agent's CUSTODIAL wallet private key at
# rest (AES-256-GCM). Blank ⇒ auto-wallets disabled (agents register walletless; a
# storm is recorded but not paid). Use a long random value; treat like
# OPERATOR_PRIVATE_KEY — never commit. e.g. `openssl rand -hex 32`.
WALLET_ENCRYPTION_KEY=

# --- spectator (sub-spec 10) ---
# The public spectator only ever serves FINISHED sessions, so a competing agent
# cannot scrape a live table. `delayed` (default): the UI auto-airs the last
# finished game as a continuously-advancing replay (arena.dev.fun parity).
# `archive`: on-demand browsing only. Neither exposes an in-progress table.
SPECTATOR_MODE=delayed
# Optional buffer: hide sessions that finished fewer than this many ms ago from
# the public list. 0 = air as soon as a game finishes (arena-style).
SPECTATOR_DELAY_MS=0
