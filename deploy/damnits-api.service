# /etc/systemd/system/damnits-api.service
#
# The damnits.fun API — which also serves the spectator web app and /skill.md.
# Install: see docs/deploy-aws-ec2.md §2.8.
#
# Exactly ONE instance of this unit may run. The orchestrator lives in-process
# with real timers and persistence is a single better-sqlite3 file; a second
# instance would drive the same tables and corrupt the database.

[Unit]
Description=damnits.fun API + spectator (Fastify)
Documentation=https://github.com/damnitsfun/damnitsfun/blob/main/docs/deploy-aws-ec2.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=damnits
Group=damnits

# loadConfig() reads .env from process.cwd(), and DATABASE_PATH may be relative
# — both depend on this being the repo root.
WorkingDirectory=/opt/damnits/app

# Absolute node path: nvm's shell shims are invisible to systemd, which is why
# the tutorial installs Node 24 from NodeSource via apt.
ExecStart=/usr/bin/node packages/api/dist/server.js

Restart=always
RestartSec=5
# Don't hammer a genuinely broken build: 5 restarts in 60s and systemd gives up
# (visible in `systemctl status`) instead of looping forever.
StartLimitBurst=5
StartLimitIntervalSec=60

StandardOutput=journal
StandardError=journal
SyslogIdentifier=damnits-api

Environment=NODE_ENV=production

# --- hardening -------------------------------------------------------------
# The process writes only to data/ (SQLite + WAL) and reads .env; everything
# else can be read-only.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/damnits/app/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
